(version 1)
(deny default)
(allow process-exec process-fork sysctl-read)
; dyld needs the root inode, not root descendants.
(allow file-read* (literal "/") (subpath "/System/Library") (subpath "/usr/lib")
 (literal "/System/Cryptexes/OS") (literal "/System/Volumes/Preboot/Cryptexes/OS")
 ; Rosetta loads the OS x86_64 dyld shared cache from the mounted Cryptex.
 (subpath "/System/Cryptexes/OS/System/Library/dyld")
 (subpath "/System/Volumes/Preboot/Cryptexes/OS/System/Library/dyld")
 (subpath "/Library/Apple/usr/libexec/oah") (subpath "/Library/Apple/usr/lib")
 (subpath (param "READ0")) (subpath (param "READ1")) (subpath (param "READ2"))
 (subpath (param "READ3")) (subpath (param "READ4")) (subpath (param "READ5"))
 (subpath (param "READ6")) (subpath (param "READ7")) (subpath (param "READ8"))
 (subpath (param "READ9")) (subpath (param "READ10")) (subpath (param "READ11"))
 (subpath (param "SOURCE"))
 (literal "/dev/urandom") (literal "/dev/random") (literal "/dev/null"))
(allow file-read* file-write* (subpath (param "CHILD")))
(deny network*)

; realpath/resource validation needs metadata of exact ancestor inodes only.
(allow file-read-metadata
 (literal "/System/Cryptexes/OS") (literal "/usr/libexec/rosetta/runtime")
 (literal (param "ANCESTOR0"))
 (literal (param "ANCESTOR1"))
 (literal (param "ANCESTOR2"))
 (literal (param "ANCESTOR3"))
 (literal (param "ANCESTOR4"))
 (literal (param "ANCESTOR5"))
 (literal (param "ANCESTOR6"))
 (literal (param "ANCESTOR7"))
 (literal (param "ANCESTOR8"))
 (literal (param "ANCESTOR9"))
 (literal (param "ANCESTOR10"))
 (literal (param "ANCESTOR11"))
 (literal (param "ANCESTOR12"))
 (literal (param "ANCESTOR13"))
 (literal (param "ANCESTOR14"))
 (literal (param "ANCESTOR15"))
 (literal (param "ANCESTOR16"))
 (literal (param "ANCESTOR17"))
 (literal (param "ANCESTOR18"))
 (literal (param "ANCESTOR19"))
 (literal (param "ANCESTOR20"))
 (literal (param "ANCESTOR21"))
 (literal (param "ANCESTOR22"))
 (literal (param "ANCESTOR23"))
 (literal (param "ANCESTOR24"))
 (literal (param "ANCESTOR25"))
 (literal (param "ANCESTOR26"))
 (literal (param "ANCESTOR27"))
 (literal (param "ANCESTOR28"))
 (literal (param "ANCESTOR29"))
 (literal (param "ANCESTOR30"))
 (literal (param "ANCESTOR31"))
 (literal (param "ANCESTOR32"))
 (literal (param "ANCESTOR33"))
 (literal (param "ANCESTOR34"))
 (literal (param "ANCESTOR35"))
 (literal (param "ANCESTOR36"))
 (literal (param "ANCESTOR37"))
 (literal (param "ANCESTOR38"))
 (literal (param "ANCESTOR39"))
 (literal (param "ANCESTOR40"))
 (literal (param "ANCESTOR41"))
 (literal (param "ANCESTOR42"))
 (literal (param "ANCESTOR43"))
 (literal (param "ANCESTOR44"))
 (literal (param "ANCESTOR45"))
 (literal (param "ANCESTOR46"))
 (literal (param "ANCESTOR47"))
)
